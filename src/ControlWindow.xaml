<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="桌面蟑螂 · Desktop Roach" Width="1200" Height="810" MinWidth="920" MinHeight="670" WindowStartupLocation="CenterScreen" Background="#191C1D" Foreground="#E7EFEB" FontFamily="Microsoft YaHei UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#C4D2CB"/><Setter Property="Background" Value="#1B2924"/><Setter Property="BorderBrush" Value="#33453B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#8AD6B2"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Height" Value="44"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#C4D2CB"/><Setter Property="Margin" Value="0,10,0,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ToolTip"><Setter Property="Background" Value="#24362D"/><Setter Property="Foreground" Value="#E7EFEB"/><Setter Property="BorderBrush" Value="#4D6F5D"/><Setter Property="Padding" Value="12,8"/></Style>
  </Window.Resources>
  <Grid Background="#191C1D">
    <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
    <Border BorderBrush="#2A3A32" BorderThickness="0,0,0,1" Padding="26,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#ACE3C4" Width="38" Height="38" CornerRadius="7" Margin="0,0,13,0"><TextBlock Text="&#xE825;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#173B2A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel><TextBlock Text="桌面蟑螂" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="DESKTOP ROACH / 生态控制台" FontSize="10" Foreground="#8A9F93" Margin="0,3,0,0"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="PetsButton" Height="38" Padding="14,0" Margin="0,0,9,0" ToolTip="派遣桌宠、喂食与陪伴"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE902;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="桌宠小队"/></StackPanel></Button>
          <Button x:Name="PauseButton" Width="42" Height="38" Padding="0" Margin="0,0,9,0" ToolTip="暂停 / 继续"><TextBlock x:Name="PauseIcon" Text="&#xE769;" FontFamily="Segoe MDL2 Assets" FontSize="15"/></Button>
          <Button x:Name="DesktopButton" Background="#ACE3C4" Foreground="#183D2B" BorderBrush="#ACE3C4" Height="38" Padding="16,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock x:Name="DesktopButtonText" Text="开启桌面入侵" FontWeight="SemiBold"/></StackPanel></Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border BorderBrush="#2A3A32" BorderThickness="0,0,1,0" Padding="18,23,18,16">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="工具箱" FontSize="11" Foreground="#879D8F" Margin="12,0,0,15"/>
            <Button x:Name="ObserveTool" Style="{StaticResource ToolButton}" ToolTip="观察生态，桌面鼠标穿透"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="20" Width="34"/><TextBlock Text="日常办公"/></StackPanel></Button>
            <Border Height="1" Background="#2A3A32" Margin="10,8,10,15"/>
            <Button x:Name="SwatterTool" Style="{StaticResource ToolButton}" ToolTip="蟑螂拍 · 单击拍打，冷却 0.28 秒"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="20" Width="34"/><TextBlock Text="蟑螂拍"/></StackPanel></Button>
            <Button x:Name="SprayTool" Style="{StaticResource ToolButton}" ToolTip="喷雾 · 范围消杀，冷却 2.5 秒"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9CE;" FontFamily="Segoe MDL2 Assets" FontSize="20" Width="34"/><TextBlock Text="杀虫喷雾"/></StackPanel></Button>
            <Button x:Name="BaitTool" Style="{StaticResource ToolButton}" ToolTip="蟑螂药 · 放置 90 秒诱饵，最多 5 份"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="20" Width="34"/><TextBlock Text="蟑螂药"/></StackPanel></Button>
            <Button x:Name="BroomTool" Style="{StaticResource ToolButton}" ToolTip="扫把 · 按住清扫食物、卵鞘和残骸"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xEA99;" FontFamily="Segoe MDL2 Assets" FontSize="20" Width="34"/><TextBlock Text="扫把"/></StackPanel></Button>
            <Button x:Name="MopTool" Style="{StaticResource ToolButton}" ToolTip="拖把 · 按住清除油污、降低混浊"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81B;" FontFamily="Segoe MDL2 Assets" FontSize="20" Width="34"/><TextBlock Text="拖把"/></StackPanel></Button>
          </StackPanel>
          <StackPanel Grid.Row="2" Margin="10,12,0,0"><TextBlock Text="本次清理" FontSize="11" Foreground="#879D8F"/><TextBlock x:Name="SessionScore" Text="0 击杀 / 0 清扫" Margin="0,8,0,0" FontSize="13"/><Button x:Name="ResetButton" Margin="0,15,10,0" Background="Transparent" BorderBrush="#425047" ToolTip="重置游戏生态"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="重新开始"/></StackPanel></Button></StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1" Margin="26,23,26,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock x:Name="ViewTitle" Text="桌面演练场" FontSize="24" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="#ACE3C4" Margin="0,0,7,0"/><TextBlock x:Name="ActivityText" Text="生态运行中" Foreground="#96AE9F" FontSize="11"/><TextBlock Text="  /  " Foreground="#556C5C"/><TextBlock x:Name="ElapsedText" Text="00:00" Foreground="#96AE9F" FontSize="11"/></StackPanel></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" Foreground="#9CB4A5" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="ModeText" Text="演练模式" Foreground="#9CB4A5" FontSize="12"/></StackPanel>
        </Grid>
        <Border Grid.Row="1" BorderBrush="#465B4D" BorderThickness="1" CornerRadius="6" Background="#EAF0ED" ClipToBounds="True"><Grid x:Name="SceneHost"/></Border>
        <Grid Grid.Row="2" Margin="0,21,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="活跃蟑螂" FontSize="11" Foreground="#96AE9F"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock x:Name="RoachCount" Text="03" FontSize="29" FontFamily="Bahnschrift"/><TextBlock x:Name="BabyCount" Text="幼虫 0" Foreground="#91A795" FontSize="10" Margin="9,15,0,0"/></StackPanel></StackPanel>
          <StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="待孵化卵鞘" FontSize="11" Foreground="#96AE9F"/><TextBlock x:Name="EggCount" Text="00" FontSize="29" Foreground="#DFB67C" FontFamily="Bahnschrift" Margin="0,5,0,0"/></StackPanel>
          <StackPanel Grid.Column="2" Margin="14,0,0,0"><TextBlock Text="桌面污物" FontSize="11" Foreground="#96AE9F"/><TextBlock x:Name="DirtCount" Text="02" FontSize="29" FontFamily="Bahnschrift" Margin="0,5,0,0"/></StackPanel>
          <StackPanel Grid.Column="3" Margin="14,0,0,0"><Grid><TextBlock Text="污染程度" FontSize="11" Foreground="#96AE9F"/><TextBlock x:Name="PollutionText" Text="0%" HorizontalAlignment="Right" FontSize="11" Foreground="#ACE3C4"/></Grid><ProgressBar x:Name="PollutionBar" Height="5" Maximum="100" Margin="0,15,0,0" Background="#304537" Foreground="#ACE3C4" BorderThickness="0"/><TextBlock x:Name="HealthText" Text="桌面清爽" Margin="0,8,0,0" FontSize="10" Foreground="#7E9988"/></StackPanel>
        </Grid>
        <Border Grid.Row="3" BorderBrush="#2D4033" BorderThickness="0,1,0,0" Padding="0,17,0,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="入侵强度" Foreground="#96AE9F" FontSize="11"/><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><Button x:Name="EasyButton" Content="轻松" Padding="18,7" Margin="0,0,5,0"/><Button x:Name="NormalButton" Content="标准" Padding="18,7" Margin="0,0,5,0"/><Button x:Name="HardButton" Content="失控" Padding="18,7"/></StackPanel></StackPanel><StackPanel Grid.Column="1"><CheckBox x:Name="ObjectsCheck" Content="桌面仿真物件" IsChecked="True"/><CheckBox x:Name="FullscreenCheck" Content="全屏应用时自动隐藏" IsChecked="True"/></StackPanel></Grid>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="#0E1713" BorderBrush="#2A3A32" BorderThickness="0,1,0,0" Padding="25,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="#81AD92" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock x:Name="EventText" Text="桌面巡逻已开始" FontSize="11" Foreground="#96AE9F" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="1" x:Name="SaveText" Text="本地存档 · v0.1" VerticalAlignment="Center" FontSize="10" Foreground="#6C8976"/></Grid></Border>
  </Grid>
</Window>
